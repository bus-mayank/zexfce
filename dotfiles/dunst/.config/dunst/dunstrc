[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 300
    origin = top-right
    offset = 10x40
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 10
    corner_radius = 10
    frame_width = 2
    frame_color = "#89b4fa"
    font = JetBrainsMono Nerd Font 10

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
